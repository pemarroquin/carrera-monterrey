# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
# No trailing slash: 'node_modules/' matches only DIRECTORIES, so a
# node_modules SYMLINK (one gets created when typechecking a git worktree
# that has no install of its own) slipped straight past it and was committed.
node_modules

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# web deploy build artifacts (rebuilt on demand, not source)
deploy/

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files — NEVER commit one. THIS REPO IS PUBLIC, so a committed
# env file is published the moment it is pushed, and rewriting history does
# not un-publish it (forks, clones and GitHub's own cached views keep it).
#
# `.env*.local` alone was NOT enough: it matches .env.local but not a bare
# `.env`, nor .env.production, .env.staging and friends. Today that gap is
# harmless — the only vars here are EXPO_PUBLIC_* ones that ship inside the
# web bundle anyway — but a service-role key dropped into `.env` would be a
# full database compromise, and nothing would have stopped it.
#
# The negation keeps a documented .env.example trackable, which is the right
# place for variable NAMES with empty values.
.env
.env.*
!.env.example

# typescript
*.tsbuildinfo

example

# generated native folders
/ios
/android

# Claude Code worktree metadata (local tooling, never source)
.claude/

# Generated one-off data backfills (npm run convert-tile-res). Regenerable
# from the live database at any time, and they embed a person's own location
# history — that does not belong in git permanently. The SCHEMA half of any
# such change lives in supabase/migrations/ and IS committed.
supabase/generated/
